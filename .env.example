# AI Studio - optional environment overrides.
#
# Copy to .env ONLY if you need these. .env is gitignored and must never be committed.
# Nothing here is required on a normal workstation: GitHub and Figma credentials live in
# the OS credential store and Claude Code's credential store respectively, NOT here.

# Path to the private AI-Studio knowledge vault. If unset, studio looks for a sibling
# directory named AI-Studio containing 00_System/.
# STUDIO_VAULT=/absolute/path/to/AI-Studio

# Override which Python runs the CLI (must be 3.10+).
# STUDIO_PYTHON=python3.12

# Override the Claude config directory (defaults to ~/.claude).
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude

# Only for headless/CI use, where no OS credential store is available. On a workstation
# prefer `gh auth login` or Git Credential Manager so no token is written to disk.
# Needs scopes: repo (and workflow for Actions).
# GITHUB_PERSONAL_ACCESS_TOKEN=
