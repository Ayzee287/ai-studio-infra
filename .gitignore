# Never commit credentials or machine state.
.env
.env.local
*.local
**/.credentials.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime artefacts that must never be published
*.log
.playwright-mcp/
screenshots/
tool-results/
backups/
